# ------------------------------------------------------------
# Secure Document Vault (SDV) frontend - local dev environment
# Copy to .env.local (git-ignored) and adjust if your ports differ.
#
# These are all PUBLIC OIDC client identifiers, never secrets - never put a
# Google client secret, encryption key, or Google/Keycloak token in a VITE_*
# variable (they end up in the built browser bundle).
# ------------------------------------------------------------

# Keycloak server origin - matches KEYCLOAK_ISSUER_URI's host in the backend's
# .env.example (http://localhost:8180/realms/sdv). No trailing slash.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=sdv
# Public browser SPA client added to infra/keycloak/realm-export.json (M16A) -
# Authorization Code + PKCE, no client secret. Distinct from the existing
# confidential-looking sdv-backend client, which stays standardFlowEnabled=false.
VITE_KEYCLOAK_CLIENT_ID=sdv-frontend
