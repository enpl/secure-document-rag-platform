{
  "realm": "sdv-testbed",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "SDV application user (F-BE-009 Role.USER) - testbed fixture"
      },
      {
        "name": "ADMIN",
        "description": "SDV application administrator (F-BE-009 Role.ADMIN) - testbed fixture. Not a Keycloak server administrator."
      }
    ]
  },
  "clients": [
    {
      "clientId": "sdv-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["web-origins", "profile", "roles"],
      "protocolMappers": [
        {
          "name": "sdv-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sdv-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sdv-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:15173/*"],
      "webOrigins": ["http://localhost:15173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "web-origins", "profile", "roles"],
      "protocolMappers": [
        {
          "name": "sdv-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sdv-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "sdv-user",
      "enabled": true,
      "emailVerified": true,
      "email": "sdv-user@testbed.local",
      "firstName": "SDV",
      "lastName": "User",
      "realmRoles": ["USER"]
    },
    {
      "username": "sdv-admin-a",
      "enabled": true,
      "emailVerified": true,
      "email": "sdv-admin-a@testbed.local",
      "firstName": "SDV",
      "lastName": "Admin A",
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "sdv-admin-b",
      "enabled": true,
      "emailVerified": true,
      "email": "sdv-admin-b@testbed.local",
      "firstName": "SDV",
      "lastName": "Admin B",
      "realmRoles": ["ADMIN"]
    }
  ]
}
