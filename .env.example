# ============================================================
# Secure Document Vault (SDV) - Core MVP environment template
#
# Copy to a local, git-ignored env file (e.g. .env) or export as
# real shell/IDE environment variables before running the backend.
# Values below are safe local-dev examples only - never commit
# real secrets here.
# ============================================================

# ------------------------------------------------------------
# General
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
# Core-spec placeholder - Core MVP primary deployment target.
DEPLOYMENT_MODE=ON_PREM

# ------------------------------------------------------------
# Spring / Database (PostgreSQL + pgvector)
# Canonical datasource contract per latest v3.2 master spec.
# application-local.yml / application-compose.yml now read these
# SPRING_DATASOURCE_* / SPRING_FLYWAY_* names directly (no more
# DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD drift).
#
# `sdv` is the restricted runtime application role (no SUPERUSER,
# CREATEDB, CREATEROLE, REPLICATION, BYPASSRLS, ownership, or schema
# CREATE - see backend/src/main/resources/db/callback/
# afterMigrate__grant_runtime_privileges.sql). Both password variables
# are left empty here on purpose: application-local.yml /
# application-compose.yml define no default for either, so an unset
# value fails Spring placeholder resolution at startup instead of
# silently working with a value that looks like a real secret. Get the
# actual local value from infra/secrets/ (see infra/secrets/README.md) -
# never commit a real value here.
# ------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sdv
SPRING_DATASOURCE_USERNAME=sdv
SPRING_DATASOURCE_PASSWORD=

# sdv_user is the existing bootstrap administrator and the local/compose
# Flyway migration identity (a local-development compromise, not
# production credential isolation - see application-local.yml).
SPRING_FLYWAY_USER=sdv_user
SPRING_FLYWAY_PASSWORD=

# ------------------------------------------------------------
# Kafka
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------
# Keycloak
# ------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/sdv
KEYCLOAK_AUDIENCE=sdv-backend

# ------------------------------------------------------------
# AI / RAG (Ollama/local LLM is the default provider)
# ------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434
# External LLM stays OFF by default (INV-AI-002). Core-spec placeholder.
EXTERNAL_LLM_ENABLED=false
# Number of chunks returned per RAG retrieval. Core-spec placeholder.
RAG_TOP_K=8
# Embedding model decision for Core MVP RAG (see V002__pgvector.sql:
# vector(1024), cosine, HNSW). Changing model/dimension requires
# re-indexing. Core-spec placeholder.
EMBEDDING_MODEL=bge-m3:567m

# ------------------------------------------------------------
# Google Drive Source (OAuth)
# M08 MVP OAuth (docs/spec/SDV_M08_TOKEN_CONTRACT.md) - GoogleDriveOAuthController/
# GoogleTokenService/GoogleTokenStoreAdapter are implemented. A missing/invalid value
# here makes OAuth-specific endpoints fail closed (503 OAUTH_UNAVAILABLE) while the
# rest of the backend keeps working - it does not block application startup.
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-local-secret
GOOGLE_CLIENT_SECRET=replace-with-local-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/admin/sources/google/callback
# Preferred (protected secret file, e.g. a Docker Compose secret mount) - a file
# containing only the base64 32-byte AES key. Leave unset to use the env var below.
SOURCE_TOKEN_ENCRYPTION_KEY_FILE=
# Explicit local/dev alternative to the file above - a base64-encoded 32-byte AES key.
# Must decode to exactly 32 bytes; a placeholder/default value is refused at first use.
SOURCE_TOKEN_ENCRYPTION_KEY=replace-with-local-secret
# Label for whichever key material is currently active (MVP supports exactly one
# active key - see docs/plan/SDV_MVP_DEFERRED.md MVP-10 for rotation).
SOURCE_TOKEN_ENCRYPTION_KEY_ID=local-dev-v1

# ------------------------------------------------------------
# Local Vault
# Core-spec placeholder - Local Vault is a Core MVP Source (VAU-001~006)
# but VaultCryptoService/VaultStorageAdapter are not implemented yet.
# ------------------------------------------------------------
VAULT_STORAGE_PATH=C:\secure-document-vault\data\vault
VAULT_MASTER_KEY=replace-with-local-secret
VAULT_KEY_VERSION=v1
# Max Local Vault upload size in bytes (25 MiB).
MAX_UPLOAD_BYTES=26214400

# ------------------------------------------------------------
# Permission / Operations
# ------------------------------------------------------------
# Stale/unknown ACL state Fail Closes regardless of this value (INV-SRC-002).
# Core-spec placeholder.
PERMISSION_STALE_SECONDS=300
# Core-spec placeholder - no logging.level.* binding exists yet.
LOG_LEVEL=INFO
